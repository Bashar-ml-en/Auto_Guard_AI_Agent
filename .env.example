# ==========================================
# AutoGuard AI - Configuration
# ==========================================

# Google Gemini API Key (from Google AI Studio or Vertex AI)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (e.g., gemini-2.5-flash, gemini-1.5-pro, gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Google Cloud Platform Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GCS_BUCKET_NAME=autoguard-audit-artifacts

# Cloud Run Configuration
CLOUD_RUN_SERVICE_NAME=autoguard-fortified-agent

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
ENABLE_MOCK_FALLBACK=true
